{
  "crons": [
    {
      "path": "/api/cron-reminder",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron-reminder",
      "schedule": "0 13 * * 4"
    },
    {
      "path": "/api/cron-reminder",
      "schedule": "0 1 * * 5"
    },
    {
      "path": "/api/cron-review",
      "schedule": "0 4 * * 5"
    },
    {
      "path": "/api/cron-senior",
      "schedule": "0 8 * * 5"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}