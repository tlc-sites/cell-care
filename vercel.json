{
  "crons": [
    {
      "path": "/api/cron-reminder",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron-reminder",
      "schedule": "0 13 * * 4"
    },
    {
      "path": "/api/cron-reminder",
      "schedule": "0 1 * * 5"
    },
    {
      "path": "/api/cron-review",
      "schedule": "0 4 * * 5"
    },
    {
      "path": "/api/cron-senior",
      "schedule": "0 8 * * 5"
    },
    {
      "path": "/api/cron-weekly-email",
      "schedule": "0 8 * * 5"
    }
  ],
  "rewrites": [
    { "source": "/api/cron-weekly-email", "destination": "/api/cron-senior?delivery=email" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/cron-senior.js": {
      "maxDuration": 300
    },
    "api/translate.js": {
      "maxDuration": 60
    },
    "api/senior-comment.js": {
      "maxDuration": 60
    },
    "api/pastor-message.js": {
      "maxDuration": 60
    }
  }
}
